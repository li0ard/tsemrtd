{
  "name": "@li0ard/tsemrtd",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "version": "0.3.3",
  "type": "module",
  "author": "li0ard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/li0ard/tsemrtd.git"
  },
  "bugs": {
    "url": "https://github.com/li0ard/tsemrtd/issues"
  },
  "homepage": "https://github.com/li0ard/tsemrtd#readme",
  "description": "simple library for eMRTD. supports browsers, node, bun and more!",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist/ && tsc --project tsconfig.build.json",
    "check": "bun run build && bunx jsr publish --dry-run --allow-dirty && rm -rf dist/",
    "docs": "typedoc --options .config/typedoc/config.cjs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typedoc": "^0.26.6"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@li0ard/tinytlv": "^0.1.1",
    "@peculiar/asn1-cms": "^2.6.0",
    "@peculiar/asn1-schema": "^2.6.0",
    "@peculiar/asn1-x509": "^2.6.0"
  },
  "keywords": ["emrtd", "mrtd", "icao", "tsemrtd", "9303", "passport"]
}